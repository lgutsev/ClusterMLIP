+    pieces: list[str] = []
+    depth = 0
+    current = ""
+    for char in route:
+        if char == "(":
+            depth += 1
+        elif char == ")":
+            depth = max(depth - 1, 0)
+        if depth == 0 and char in " \t\r\n,":
+            if current:
+                pieces.append(current)
+            current = ""
+            continue
+        current += char
+    if current:
+        pieces.append(current)
+    # "Opt = TS" and "Opt (TS)" still name one keyword.
+    merged: list[str] = []
+    for piece in pieces:
+        if merged and (
+            merged[-1].endswith("=") or piece.startswith("=")
+            or (piece.startswith("(") and not re.search(r"[=(]", merged[-1]))
+        ):
